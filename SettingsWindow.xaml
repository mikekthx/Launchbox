<Window
    x:Class="Launchbox.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Launchbox.Helpers"
    xmlns:local="using:Launchbox"
    xmlns:models="using:Launchbox.Models"
    xmlns:viewmodels="using:Launchbox.ViewModels">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="8">
                <Image Source="/Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                       Width="16" Height="16"
                       AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock x:Uid="Settings_TitleText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContent" Padding="24" Spacing="20" HorizontalAlignment="Left" MaxWidth="500">
                <!-- General -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_GeneralHeader" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Uid="Settings_StartupToggle" IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" />
                </StackPanel>

                <!-- Shortcut Folders -->
                <TextBlock x:Name="FolderListHeader" x:Uid="Settings_FolderList" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />

                <ListView x:Name="FolderList"
                          AutomationProperties.LabeledBy="{Binding ElementName=FolderListHeader}"
                          ItemsSource="{x:Bind ViewModel.Folders}"
                          SelectionMode="None"
                          MaxHeight="200"
                          CanReorderItems="True"
                          AllowDrop="True"
                          CanDragItems="True"
                          helpers:ListViewBaseExtensions.DragItemsCompletedCommand="{x:Bind ViewModel.PersistFolderSequenceCommand}">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ShortcutFolder">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Padding="4" ColumnSpacing="4"
                            Background="Transparent"
                            AutomationProperties.Name="{x:Bind Label}"
                            ToolTipService.ToolTip="{x:Bind Label}">
                        <StackPanel>
                          <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{x:Bind Path}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTipService.ToolTip="{x:Bind Path}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="Settings_MoveUp"
                                Command="{Binding ElementName=SettingsContent, Path=DataContext.ViewModel.MoveFolderUpCommand}"
                                CommandParameter="{x:Bind Order}" Padding="4">
                          <FontIcon Glyph="&#xE74A;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                        <Button Grid.Column="2" x:Uid="Settings_MoveDown"
                                Command="{Binding ElementName=SettingsContent, Path=DataContext.ViewModel.MoveFolderDownCommand}"
                                CommandParameter="{x:Bind Order}" Padding="4">
                          <FontIcon Glyph="&#xE74B;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                        <Button Grid.Column="3" x:Uid="Settings_RenameFolder"
                                Command="{Binding ElementName=SettingsContent, Path=DataContext.ViewModel.RenameFolderCommand}" CommandParameter="{x:Bind}" Padding="4">
                          <SymbolIcon Symbol="Edit" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                        <Button Grid.Column="4" x:Uid="Settings_RemoveFolder"
                                Command="{Binding ElementName=SettingsContent, Path=DataContext.ViewModel.RemoveFolderCommand}"
                                CommandParameter="{x:Bind Order}" Padding="4">
                          <SymbolIcon Symbol="Delete" AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button x:Uid="Settings_AddFolder" Command="{x:Bind ViewModel.AddFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Uid="Settings_AddFolderText" />
                        </StackPanel>
                    </Button>
                    <ProgressRing x:Uid="Settings_AddFolderProgress"
                                  IsActive="{x:Bind ViewModel.AddFolderCommand.IsRunning, Mode=OneWay}"
                                  Width="16" Height="16"
                                  VerticalAlignment="Center" />
                </StackPanel>

                <!-- View Mode -->
                <TextBlock x:Name="ViewModeHeader" x:Uid="Settings_ViewMode" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,8" />
                <ComboBox AutomationProperties.LabeledBy="{Binding ElementName=ViewModeHeader}"
                          ItemsSource="{x:Bind ViewModel.ViewModeOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedViewModeOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" Width="150" />
                <ToggleSwitch x:Uid="Settings_CollapsibleGroups"
                              IsOn="{x:Bind ViewModel.CollapsibleGroups, Mode=TwoWay}"
                              Margin="0,8,0,0" />

                <!-- Hotkey -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_HotkeyHeader" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Uid="Settings_HotkeyModifier" ItemsSource="{x:Bind ViewModel.Modifiers}" SelectedItem="{x:Bind ViewModel.SelectedModifier, Mode=TwoWay}" Width="100" />
                        <TextBlock Text="+" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBox x:Uid="Settings_HotkeyKey" Text="{x:Bind ViewModel.HotkeyKeyString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_AppearanceHeader" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="IconSizeLabel" x:Uid="Settings_IconSizeLabel" VerticalAlignment="Center"/>
                        <ComboBox x:Uid="Settings_IconSizeCombo"
                                  AutomationProperties.LabeledBy="{Binding ElementName=IconSizeLabel}"
                                  ItemsSource="{x:Bind ViewModel.GridSizeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGridSize, Mode=TwoWay}"
                                  Width="120" />
                    </StackPanel>
                </StackPanel>

                <!-- Window -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_WindowHeader" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <Button x:Uid="Settings_ResetPosition" Command="{x:Bind ViewModel.ResetPositionCommand}" />
                    <ToggleSwitch x:Uid="Settings_KeepCentered"
                                  IsOn="{x:Bind ViewModel.KeepCentered, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

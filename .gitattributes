# Auto-detect text files and normalize line endings to CRLF in the repo
* text=auto eol=crlf

# Force CRLF for source files
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.md text eol=crlf
*.xml text eol=crlf
*.resw text eol=crlf
*.editorconfig text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.manifest text eol=crlf
*.pubxml text eol=crlf

# Binary files
*.png binary
*.ico binary
*.pfx binary

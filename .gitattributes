# Normalize all text files to LF in the repo and on checkout.
# core.autocrlf=true on Windows is overridden by explicit eol=lf here.
* text=auto eol=lf

# Explicit LF for source files (defense-in-depth against eol drift from GitHub/CI)
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.resw text eol=lf
*.editorconfig text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.manifest text eol=lf
*.pubxml text eol=lf

# Binary files
*.png binary
*.ico binary
*.pfx binary
